		<!-- Digital Clock -->
		<!-- FontFamilyを正しく読み込むには、プロジェクトにFontsフォルダがあり、PressStart2P-Regular.ttf(など)が配置されていて、Build ActionがResourceになっている必要があります -->
		<TextBlock x:Name="DigitalClock"
				   HorizontalAlignment="Right"
				   VerticalAlignment="Top"
				   Margin="0,100,70,0" 
				   FontSize="45" 
				   Foreground="#aeb8e2"
				   FontFamily="./Fonts/#Press Start 2P"
				   Panel.ZIndex="5">
			<!-- 影（ドロップシャドウ）による青のぼかした縁取り -->
			<TextBlock.Effect>
				<DropShadowEffect Color="#00BFFF" 
								  BlurRadius="15" 
								  ShadowDepth="0" 
								  Opacity="1"/> 
			</TextBlock.Effect>
			<!-- 3D回転効果（PlaneProjectionのように見せるTransform） -->
			<TextBlock.RenderTransform>
				<TransformGroup>
					<!-- スキュー（傾き）やスケールを組み合わせて疑似的な3D回転を表現 -->
					<SkewTransform AngleY="3.8" /> <!-- 縦方向の傾き（X軸回転風） -->
					<!-- 他にも ScaleTransform や RotateTransform を追加して調整可能 -->
				</TransformGroup>
			</TextBlock.RenderTransform>
		</TextBlock>

                <TextBlock x:Name="DigitalDate"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,60,160,0" 
                   FontSize="30" 
                   Foreground="#aeb8e2"
                   FontFamily="{StaticResource ShinonomeFont}"
                   Panel.ZIndex="5">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00BFFF" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleY="3." />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>


                <TextBlock x:Name="LiveElapsedClock"
