									Panel.ZIndex="2"
									Background="Transparent" Foreground="White" BorderThickness="0" Click="NotificationClose_Click"/>
							<emoji:TextBlock Text="{Binding Header}" Foreground="White" FontSize="28" Margin="0,0,30,8"
									   FontFamily="{StaticResource ShinonomeFont}" 
									   TextWrapping="Wrap">
								<emoji:TextBlock.Effect>
									<DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="1"/>
								</emoji:TextBlock.Effect>
							</emoji:TextBlock>
							<emoji:TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="White" FontSize="26" TextWrapping="Wrap"
									   FontFamily="{StaticResource ShinonomeFont}">
