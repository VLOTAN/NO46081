                        <CheckBox x:Name="ChkStartWithWindows" Content="バックグラウンド起動する(PC起動時にも自動で起動します)" Foreground="White" Margin="0,0,0,20"/>
<TextBlock Text="タイムスタンプショートカットキー:" Foreground="White" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBox x:Name="TxtMemoShortcutKey" Width="220" Height="30" Text="Ctrl+Shift+M"
                                     VerticalContentAlignment="Center" Foreground="White" Background="#2D2D2D"
                                     BorderBrush="#666666" BorderThickness="1" Padding="8,4" IsReadOnly="True"
                                     PreviewKeyDown="TxtMemoShortcutKey_PreviewKeyDown"/>
                            <TextBlock Text="（ここを選択してキーを押す）" Foreground="#BBBBBB"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                                                        <CheckBox x:Name="ChkSoundEffectsEnabled" Content="効果音を鳴らす" Foreground="White" IsChecked="True" Margin="0,0,0,20" Checked="ChkSoundEffectsEnabled_CheckedChanged" Unchecked="ChkSoundEffectsEnabled_CheckedChanged"/>
                                <CheckBox x:Name="ChkNotificationSoundEnabled" Content="通知の効果音を鳴らす(上の「効果音を鳴らす」もオンにする必要があります)" IsChecked="True" Margin="0,0,0,20" Foreground="White" IsEnabled="{Binding IsChecked, ElementName=ChkSoundEffectsEnabled}"/>
                                <CheckBox x:Name="ChkEnableSuperChatNotification" Content="スーパーチャット通知を表示" IsChecked="False" Margin="0,0,0,20" Foreground="White"/>
                                <CheckBox x:Name="ChkEnableMemberNotification" Content="メンバーシップ通知を表示" IsChecked="False" Margin="0,0,0,20" Foreground="White"/>
                                
                                <TextBlock Text="表示モード:" Foreground="White" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton x:Name="RbFullscreenMode"
                                         Content="フルスクリーン"
                                         GroupName="WindowMode"
                                         Foreground="White"
                                         Margin="0,0,24,0"
                                         IsChecked="True"
                                         Checked="WindowModeRadio_Checked"/>
                            <RadioButton x:Name="RbWindowedMode"
                                         Content="ウィンドウ"
                                         GroupName="WindowMode"
                                         Foreground="White"
                                         Checked="WindowModeRadio_Checked"/>
                            <RadioButton x:Name="RbWindowed1920Mode"
                                         Content="1920×1080ウィンドウ"
                                         GroupName="WindowMode"
                                         Foreground="White"
                                         Margin="24,0,0,0"
                                         Checked="WindowModeRadio_Checked"/>
                        </StackPanel>

                        <TextBlock Text="マウスカーソル:" Foreground="White" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton x:Name="RbDefaultCursor"
                                         Content="通常マウスカーソル"
                                         GroupName="CursorMode"
                                         Foreground="White"
                                         Margin="0,0,24,0"
                                         IsChecked="True"
                                         Checked="CursorModeRadio_Checked"/>
                            <RadioButton x:Name="RbUrotaCursor"
                                         Content="うろたマウスカーソル"
                                         GroupName="CursorMode"
                                         Foreground="White"
                                         Checked="CursorModeRadio_Checked"/>
                        </StackPanel>

					    <TextBlock Text="サーバー構成:" Foreground="White" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <TextBlock Text="localhost:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="22"/>
						            <TextBox x:Name="TxtServerPort" Width="80" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" Text="2345" CaretBrush="Black"/>
                            <!-- Update server setting changes -->
                            <Button Content="適用/再起動" Style="{StaticResource ModernButtonStyle}" Click="BtnRestartServer_Click"/>
					    </StackPanel>

                        <TextBlock Text="OBS WebSocket:                     パスワード" Foreground="White" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBox x:Name="TxtObsWebSocketUrl" Width="200" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" Text="192.168.10.106:4455" CaretBrush="Black"/>
                            <PasswordBox x:Name="TxtObsPassword" Width="160" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" PasswordChar="*" />
                        </StackPanel>

					    

					    <Separator Background="#444444" Margin="0,0,0,20"/>

					    <TextBlock Text="OBSチャット設定" Foreground="White" Margin="0,0,0,10" FontWeight="Bold"/>
					    <Button Content="OBSチャットを編集" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Click="BtnEditObs_Click" Margin="0,0,0,20"/>

                        <Separator Background="#444444" Margin="0,0,0,20"/>
                                <Button Content="アプリを再起動" Style="{StaticResource ModernButtonStyle}" Background="#FF8C00" Click="BtnRestartApp_Click" Margin="0,0,0,20"/>
                        <Separator Background="#444444" Margin="0,0,0,20"/>
                                <UniformGrid Columns="3">
							<Button Content="最小化" Style="{StaticResource ModernButtonStyle}" Background="#444444" Click="MinimizeButton_Click" Margin="5"/>
							<Button Content="アプリを閉じる" Style="{StaticResource ModernButtonStyle}" Background="#CC3333" Click="CloseButton_Click" Margin="5"/>
							<Button x:Name="BtnCloseSettings" Content="閉じる" Style="{StaticResource ModernButtonStyle}" Click="BtnCloseSettings_Click" Margin="5"/>
						</UniformGrid>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- Popup Overlay for Memos -->

        <!-- タスク専用パネル -->
        <Border x:Name="TaskPopup" Panel.ZIndex="60" Background="#99000000" Visibility="Collapsed">
            <Grid>
                <Border Width="1120" Height="860" Background="#222222" BorderBrush="#444444" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="タスク" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="×" ToolTip="閉じる" Width="30" Height="30" Background="#444444" Foreground="White" BorderThickness="0" Click="BtnCloseTaskPanel_Click"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TasksPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

		<Border x:Name="MemoPopup" Panel.ZIndex="50" Background="Transparent" IsHitTestVisible="True" Visibility="Collapsed">
            <Grid>
                <Border Background="#222222" BorderBrush="#444444" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" Width="1480" Height="1020">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="メモ帳" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkPopOutTopmost" Content="個別ウィンドウを常に最前面に表示" Foreground="White" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Texts Memos -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="テキストメモ" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                                        <Button Content="⧉ 全て" Width="60" Height="24" Margin="5,0,0,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnPopOutTextMemos_Click" ToolTip="全メモを別ウィンドウで表示"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        
                                        <Button Content="＋" Width="24" Height="24" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnAddTextMemo_Click"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="📁" Width="28" Height="28" Margin="0,0,6,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnOpenTextFolders_Click" ToolTip="メモのフォルダ"/>
                                    <TextBlock x:Name="TextActiveFolderText" Text="[未分類]" Foreground="#BBBBBB" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="TextMemoSearchBox" Width="180" Height="28" TextChanged="TextMemoSearchBox_TextChanged" ToolTip="テキストメモを検索" Foreground="White" Background="#2D2D2D" BorderBrush="#666666" BorderThickness="1" Padding="7,5"/>
                                    <Button Content="×" Width="28" Height="28" Margin="4,0,0,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnClearTextMemoSearch_Click" ToolTip="検索をクリア"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" Height="782">
                                    <StackPanel x:Name="TextMemosPanel"/>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- List Memos (Checkboxes) -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="チェックリストメモ" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                                        <Button Content="⧉ 全て" Width="60" Height="24" Margin="5,0,0,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnPopOutListMemos_Click" ToolTip="全リストメモを別ウィンドウで表示"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        
                                        <Button Content="＋" Width="24" Height="24" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnAddListMemo_Click"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="📁" Width="28" Height="28" Margin="0,0,6,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnOpenListFolders_Click" ToolTip="リストメモのフォルダ"/>
                                    <TextBlock x:Name="ListActiveFolderText" Text="[未分類]" Foreground="#BBBBBB" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="ListMemoSearchBox" Width="180" Height="28" TextChanged="ListMemoSearchBox_TextChanged" ToolTip="チェックリストメモを検索" Foreground="White" Background="#2D2D2D" BorderBrush="#666666" BorderThickness="1" Padding="7,5"/>
                                    <Button Content="×" Width="28" Height="28" Margin="4,0,0,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnClearListMemoSearch_Click" ToolTip="検索をクリア"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" Height="782">
                                    <StackPanel x:Name="ListMemosPanel">
                                    <!-- Initial item example with individual popout button -->
                                                
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Timestamp List -->
                            <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="タイムスタンプ" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="⧉ 全て" ToolTip="全タイムスタンプを別ウィンドウで表示" Width="60" Height="24" Background="#3A3F4A" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Click="BtnPopOutAllTimestamps_Click"/>
                                        <Button x:Name="TimestampSourceDisplayModeButton"
                                                Content="ⓘ 出典:クリック"
                                                ToolTip="タイムスタンプの出典表示方法を切り替え"
                                                Height="24"
                                                MinWidth="120"
                                                Background="#3A3F4A"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="0,0,4,0"
                                                Click="TimestampSourceDisplayModeButton_Click"/>
                       
                                        <Button Content="＋" Width="24" Height="24" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnAddTimestampBox_Click"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="📁" Width="28" Height="28" Margin="0,0,6,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnOpenTimestampFolders_Click" ToolTip="タイムスタンプのフォルダ"/>
                                    <TextBlock x:Name="TimestampActiveFolderText" Text="[未分類]" Foreground="#BBBBBB" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="TimestampSearchBox" Width="180" Height="28" TextChanged="TimestampSearchBox_TextChanged" ToolTip="タイムスタンプを検索" Foreground="White" Background="#2D2D2D" BorderBrush="#666666" BorderThickness="1" Padding="7,5"/>
                                    <Button Content="×" Width="28" Height="28" Margin="4,0,0,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="BtnClearTimestampSearch_Click" ToolTip="検索をクリア"/>
                                    <Button x:Name="TimestampFilterButton" Content="🔽" Width="28" Height="28" Margin="4,0,0,0" Background="#3A3F4A" Foreground="White" BorderThickness="0" Click="TimestampFilterButton_Click" ToolTip="配信URL・録画ファイル名でフィルター"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RbTimestampLive" Content="配信" GroupName="TimestampSource" Foreground="White" Margin="0,0,16,0" IsChecked="True"/>
                                    <RadioButton x:Name="RbTimestampRecording" Content="録画" GroupName="TimestampSource" Foreground="White"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" Height="780">
                                    <StackPanel x:Name="TimestampPanel"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="全エクスポート" Style="{StaticResource ModernButtonStyle}" Margin="4" Click="BtnExportAllMemos_Click"/>
                                <Button Content="全メモ" Style="{StaticResource ModernButtonStyle}" Margin="4" Click="BtnExportTextMemos_Click"/>
                                <Button Content="全リスト" Style="{StaticResource ModernButtonStyle}" Margin="4" Click="BtnExportListMemos_Click"/>
                                <Button Content="全タイムスタンプ" Style="{StaticResource ModernButtonStyle}" Margin="4" Click="BtnExportTimestamps_Click"/>
                                <Button Content="閉じる" Style="{StaticResource ModernButtonStyle}" Width="150" Margin="4" Click="BtnCloseMemoPanel_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Canvas x:Name="FloatingmemoCanvas"
                        Panel.ZIndex="155"
                        />

                </Grid>
        </Border>

		<!-- Popup Overlay for OBS Detail Settings -->
		<Border x:Name="ObsSettingsDetail" Panel.ZIndex="60" Background="#CC000000" Visibility="Collapsed">
			<Border Background="#222222" BorderBrush="#444444" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
				<Grid Width="800">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="350"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Margin="0,0,20,0">
						<TextBlock Text="OBS チャット詳細設定" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

						<CheckBox x:Name="ChkShowUser" Content="ユーザー名を表示する" Foreground="White" IsChecked="True" Margin="0,0,0,15" Checked="ObsSettingsChanged" Unchecked="ObsSettingsChanged"/>

						<TextBlock Text="表示幅 (折り返し位置):" Foreground="White" Margin="0,0,0,5"/>
						<DockPanel Margin="0,0,0,15">
							<TextBlock Text="{Binding Value, ElementName=SliderObsWidth}" Foreground="White" Width="40" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"/>
							<Slider x:Name="SliderObsWidth" Minimum="200" Maximum="1000" Value="400" ValueChanged="ObsSettingsChanged"/>
						</DockPanel>

						<TextBlock Text="文字色 (Hex):" Foreground="White" Margin="0,0,0,5"/>
						<TextBox x:Name="TxtObsColor" Text="#FFFFFF" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,20" CaretBrush="Black" TextChanged="ObsSettingsChanged"/>

						<Button Content="戻る" Style="{StaticResource ModernButtonStyle}" Click="BtnCloseObsDetail_Click" HorizontalAlignment="Right"/>
					</StackPanel>

					<Border Grid.Column="1" Background="Black" BorderBrush="#444444" BorderThickness="1">
						<Grid>
							<TextBlock Text="Preview" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
							<wv2:WebView2 x:Name="ObsPreviewWebView" DefaultBackgroundColor="Transparent"/>
						</Grid>
					</Border>
				</Grid>
			</Border>
		</Border>

        <!-- Embedded Timestamp Editor: MainWindow と同じ HWND 内に表示するため OBS のウィンドウキャプチャにも含まれる。 -->
        <Border x:Name="TimestampEditorPopup" Panel.ZIndex="70" Background="#80000000" Visibility="Collapsed">
            <Border x:Name="TimestampEditorPopupBorder"
                    Width="720" Height="760" Background="#222222" BorderBrush="#444444" BorderThickness="1" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="TimestampEditorPopupBorder_MouseLeftButtonDown"
                    MouseMove="TimestampEditorPopupBorder_MouseMove"
                    MouseLeftButtonUp="TimestampEditorPopupBorder_MouseLeftButtonUp">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TimestampEditorPopupTranslate" X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <TextBlock Text="タイムスタンプ元：" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbTimestampPopupLive" Content="配信" GroupName="TimestampPopupSource" Foreground="White" Margin="0,0,12,0" Checked="RbTimestampPopupLive_Checked"/>
                            <RadioButton x:Name="RbTimestampPopupRecording" Content="録画" GroupName="TimestampPopupSource" Foreground="White" Margin="0,0,12,0" Checked="RbTimestampPopupRecording_Checked"/>
                            <Button Content="別ウィンドウに切り離す" Style="{StaticResource ModernButtonStyle}" Margin="4,0,0,0" Click="BtnDetachTimestampPopup_Click"/>
                            <Button Content="閉じる" Style="{StaticResource ModernButtonStyle}" Margin="4,0,0,0" Click="BtnCloseTimestampPopup_Click"/>
                            <Button Content="+" ToolTip="タイムスタンプボックスを追加" Click="BtnAddTimestampBox_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TimestampEditorPopupTitle" Text="タイムスタンプ" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TimestampEditorPopupPanel" Margin="0,0,4,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="ConfirmPopup" Panel.ZIndex="90" Background="#B0000000" Visibility="Collapsed">
            <Grid>
                <Border Width="420"
                        Background="#20242C"
                        BorderBrush="#566177"
                        BorderThickness="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="確認" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="ConfirmMessage" Foreground="#E8ECF5" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="キャンセル" Style="{StaticResource ModernButtonStyle}" Background="#3A3F4A" Margin="0,0,10,0" Click="ConfirmNo_Click"/>
                            <Button Content="OK" Style="{StaticResource ModernButtonStyle}" Background="#B23535" Click="ConfirmYes_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
		</Grid>
	</Grid>
</Viewbox>
</Window>
