                   VerticalAlignment="Top"
                   Margin="0,30,1650,0"
                   FontSize="28"
                   Foreground="#aeb8e2"
                   FontFamily="./Fonts/#Press Start 2P"
                   Panel.ZIndex="5"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="#00BFFF" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
            </TextBlock.Effect>
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <SkewTransform AngleY="-2" />
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock x:Name="RecordingElapsedClock"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,160,48,0"
                   FontSize="24"
                   Foreground="#ff5959"
                   FontFamily="./Fonts/#Press Start 2P"
                   Panel.ZIndex="5"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="#400000" BlurRadius="12" ShadowDepth="0" Opacity="1"/>
            </TextBlock.Effect>
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <SkewTransform AngleY="3.8" />
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>





